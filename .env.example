# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Server Configuration
PORT=5000

# JWT Secret Keys - GENERATE YOUR OWN SECURE KEYS!
ACCESS_TOKEN_SECRET=your-super-secret-access-token-key-change-this
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this

# Back4App Parse Server Configuration (Optional)
BACK4APP_APP_ID=your_back4app_app_id
BACK4APP_MASTER_KEY=your_back4app_master_key
BACK4APP_REST_KEY=your_back4app_rest_key
BACK4APP_JAVASCRIPT_KEY=your_back4app_javascript_key
BACK4APP_SERVER_URL=https://parseapi.back4app.com
